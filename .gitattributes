# Normalize line endings to LF for all text files so the repository is
# consistent across Windows/macOS/Linux and matches Linux CI.
* text=auto eol=lf

# Explicit text files.
*.go     text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Lockfiles: keep LF, but treat as generated in diffs.
go.sum                text eol=lf linguist-generated
web/package-lock.json text eol=lf linguist-generated
