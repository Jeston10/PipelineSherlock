# Copy to .env and adjust for your environment. Never commit a real .env.
# These defaults match docker-compose.yml for local development only.

APP_ENV=development
HTTP_ADDR=:8080

# Secrets provider. "env" (the default) reads DATABASE_URL and GITLAB_TOKEN from
# this environment. "file" reads each from <SECRETS_DIR>/<NAME> (the Docker /
# Kubernetes mounted-secret convention), keeping secret values out of the
# environment. Set SECRETS_DIR when SECRET_PROVIDER=file.
SECRET_PROVIDER=env
# SECRETS_DIR=/run/secrets

# PostgreSQL is the source of truth.
DATABASE_URL=postgres://ps:ps@localhost:5432/pipeline_sherlock?sslmode=disable

# Redis is optional (short-lived dedup / queues / rate limiting). Leave unset
# to disable Redis-backed features.
REDIS_URL=redis://localhost:6379/0

# Optional timeouts (Go duration string or integer seconds).
SHUTDOWN_TIMEOUT=15s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s

# GitLab integration (optional). The base URL defaults to https://gitlab.com.
# A token enables the reconciliation worker and failure fingerprinting (job
# traces come from the API). Leave the token unset to ingest webhooks only.
GITLAB_BASE_URL=https://gitlab.com
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Opt in to posting incident diagnoses back to the merge request a failing
# pipeline belongs to. Takes effect only when GITLAB_TOKEN is also set.
GITLAB_WRITEBACK_ENABLED=false
