# Copy to .env and adjust for your environment. Never commit a real .env.
# These defaults match docker-compose.yml for local development only.

APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL is the source of truth.
DATABASE_URL=postgres://ps:ps@localhost:5432/pipeline_sherlock?sslmode=disable

# Redis is optional (short-lived dedup / queues / rate limiting). Leave unset
# to disable Redis-backed features.
REDIS_URL=redis://localhost:6379/0

# Optional timeouts (Go duration string or integer seconds).
SHUTDOWN_TIMEOUT=15s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
